{
  "name": "uid686",
  "version": "1.0.0",
  "description": "四声道空间音频实验室：Web Audio 实时生成、模式切换、WAV/JSON 导出与参数重载一致性验证",
  "main": "index.html",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "node tests/run-tests.js && node tests/ui-smoke.js",
    "serve": "node -e \"require('http').createServer((q,s)=>{const f=require('fs'),p='.'+(q.url==='/'?'/index.html':q.url.split('?')[0]);f.readFile(p,(e,d)=>{if(e){s.writeHead(404);s.end()}else{s.end(d)}})}).listen(8080,()=>console.log('http://localhost:8080'))\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lsafjasf/202611162.git"
  },
