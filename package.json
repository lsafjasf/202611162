{
  "name": "wind-plateau-survey",
  "version": "1.0.0",
  "description": "风蚀高原测绘车 Canvas 游戏（固定 seed、确定性模拟）",
  "type": "module",
  "scripts": {
    "test": "node tests/run-tests.js && node tests/dom-smoke.mjs",
    "serve": "node -e \"import('node:http').then(({createServer})=>import('node:fs').then(({readFileSync})=>import('node:path').then(({extname,join})=>{const root=process.cwd();const types={'.html':'text/html','.js':'text/javascript','.json':'application/json'};createServer((q,s)=>{let p=q.url==='/'?'/index.html':q.url;try{const f=readFileSync(join(root,p));s.writeHead(200,{'Content-Type':types[extname(p)]||'application/octet-stream'});s.end(f)}catch{s.writeHead(404);s.end('not found')}}).listen(8123,()=>console.log('http://localhost:8123'));})))\""
  }
}
